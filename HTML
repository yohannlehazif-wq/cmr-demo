        function buildHazards() {
            // HAZARD 1: Chemical Drum Overturned
            const h1Group = new THREE.Group();
            h1Group.userData = { hazardId: 1 };

            const drum = new THREE.Mesh(
                new THREE.CylinderGeometry(0.45, 0.45, 1.3, 16),
