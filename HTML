            ctx.fillRect(10, 10, 492, 236);
            ctx.fillStyle = '#ffffff';
            ctx.font = 'bold 36px sans-serif';
            ctx.fillText('RESTEV - SANTE AU TRAVAIL', 30, 80);
            ctx.font = '22px sans-serif';
            ctx.fillText('Espace Adherents - Prévention des Risques', 30, 130);
            ctx.fillText('1. Repérer - 2. Évaluer - 3. Corriger', 30, 180);

            const texture = new THREE.CanvasTexture(canvas);
            const posterGeo = new THREE.PlaneGeometry(5, 2.5);
            const posterMat = new THREE.MeshBasicMaterial({ map: texture });
            const poster = new THREE.Mesh(posterGeo, posterMat);
            poster.position.set(0, 5.5, -9.9);
            state.scene.add(poster);
        }

        function buildProps() {
            // CNC Heavy Machine (Center Back)
