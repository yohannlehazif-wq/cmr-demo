            );
            puddle.rotation.x = -Math.PI / 2;
            puddle.position.set(0.6, 0.01, 0);
            h1Group.add(puddle);

            // Glowing Indicator Halo
            const halo1 = createHaloRing();
            h1Group.add(halo1);

            h1Group.position.set(7, 0, 2);
            state.scene.add(h1Group);
            registerInteractive(h1Group);


            // HAZARD 2: Bare Cable & Water Puddle
            const h2Group = new THREE.Group();
            h2Group.userData = { hazardId: 2 };

            const waterPuddle = new THREE.Mesh(
                new THREE.CircleGeometry(1.1, 16),
                new THREE.MeshStandardMaterial({ color: 0x1e293b, roughness: 0.05, metalness: 0.9 })
            );
            waterPuddle.rotation.x = -Math.PI / 2;
            waterPuddle.position.y = 0.01;
            h2Group.add(waterPuddle);

            // Cable
            const cable = new THREE.Mesh(
                new THREE.CylinderGeometry(0.04, 0.04, 2.5, 8),
                new THREE.MeshBasicMaterial({ color: 0x0f172a })
            );
            cable.rotation.z = Math.PI / 2.2;
            cable.position.set(0, 0.04, 0);
            h2Group.add(cable);

            // Exposed Spark Center
            const spark = new THREE.Mesh(
                new THREE.SphereGeometry(0.12, 8, 8),
