            const floor = new THREE.Mesh(floorGeo, floorMat);
            floor.rotation.x = -Math.PI / 2;
            floor.receiveShadow = true;
            state.scene.add(floor);

            // Safety Line Mat
            const lineMat = new THREE.MeshBasicMaterial({ color: 0xf59e0b });
            const line1 = new THREE.Mesh(new THREE.PlaneGeometry(0.2, 18), lineMat);
            line1.rotation.x = -Math.PI / 2;
            line1.position.set(-2, 0.01, 0);
            state.scene.add(line1);

            const line2 = new THREE.Mesh(new THREE.PlaneGeometry(0.2, 18), lineMat);
            line2.rotation.x = -Math.PI / 2;
            line2.position.set(2, 0.01, 0);
            state.scene.add(line2);

            // Back Wall
            const wallMat = new THREE.MeshStandardMaterial({ color: 0x1e293b, roughness: 0.9 });
            const backWall = new THREE.Mesh(new THREE.PlaneGeometry(24, 8), wallMat);
            backWall.position.set(0, 4, -10);
            backWall.receiveShadow = true;
            state.scene.add(backWall);

            // Left Wall
            const leftWall = new THREE.Mesh(new THREE.PlaneGeometry(20, 8), wallMat);
            leftWall.rotation.y = Math.PI / 2;
            leftWall.position.set(-12, 4, 0);
            leftWall.receiveShadow = true;
            state.scene.add(leftWall);

            // Right Wall
            const rightWall = new THREE.Mesh(new THREE.PlaneGeometry(20, 8), wallMat);
            rightWall.rotation.y = -Math.PI / 2;
            rightWall.position.set(12, 4, 0);
            rightWall.receiveShadow = true;
            state.scene.add(rightWall);

            // RESTEV Banner on Wall
            const canvas = document.createElement('canvas');
            canvas.width = 512;
            canvas.height = 256;
            const ctx = canvas.getContext('2d');
            ctx.fillStyle = '#0f172a';
            ctx.fillRect(0, 0, 512, 256);
