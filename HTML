<!DOCTYPE html>
<html lang="fr" class="h-full bg-slate-950">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>RESTEV - Chasse aux Risques VR & 3D en Atelier</title>
    
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        restev: {
                            50: '#f0fdfa',
                            100: '#ccfbf1',
                            500: '#14b8a6',
                            600: '#0d9488',
                            700: '#0f766e',
                            800: '#115e59',
                            900: '#134e4a',
                            blue: '#1e3a8a'
                        }
                    }
                }
            }
        }
    </script>

    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <!-- Three.js & Plugins -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/controls/OrbitControls.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/webxr/VRButton.js"></script>

    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <style>
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            user-select: none;
            overflow: hidden;
        }

        .glass-panel {
            background: rgba(15, 23, 42, 0.82);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid rgba(255, 255, 255, 0.12);
        }

        .glass-card {
            background: rgba(30, 41, 59, 0.7);
            backdrop-filter: blur(8px);
            border: 1px solid rgba(255, 255, 255, 0.08);
        }

        /* Custom Scrollbar */
        ::-webkit-scrollbar {
            width: 6px;
        }
        ::-webkit-scrollbar-track {
            background: rgba(15, 23, 42, 0.6);
        }
        ::-webkit-scrollbar-thumb {
            background: rgba(20, 184, 166, 0.4);
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: rgba(20, 184, 166, 0.7);
        }

        /* Print styles for Certificate */
        @media print {
            body * {
                visibility: hidden;
            }
            #certificate-print-area, #certificate-print-area * {
                visibility: visible;
            }
            #certificate-print-area {
                position: absolute;
                left: 0;
                top: 0;
                width: 100%;
                background: white !important;
                color: black !important;
            }
        }
    </style>
</head>
<body class="h-full text-slate-100 flex flex-col justify-between select-none">

    <!-- TOP HUD OVERLAY -->
    <header class="fixed top-0 left-0 right-0 z-30 p-3 sm:p-4 pointer-events-none">
        <div class="max-w-7xl mx-auto flex items-center justify-between gap-3">
            
            <!-- RESTEV Logo & Title -->
            <div class="pointer-events-auto flex items-center gap-3 glass-panel px-4 py-2.5 rounded-2xl shadow-2xl">
                <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-restev-600 to-emerald-400 flex items-center justify-center text-slate-950 font-black text-xl shadow-lg">
                    R
                </div>
                <div>
                    <h1 class="text-sm sm:text-base font-extrabold tracking-wide text-white leading-tight">
                        RESTEV <span class="text-restev-500 font-medium">| Santé au Travail</span>
                    </h1>
                    <p class="text-[11px] text-slate-400 font-medium hidden sm:block">Chasse aux Risques 3D / WebXR</p>
                </div>
            </div>

            <!-- Stats Bar -->
            <div class="pointer-events-auto flex items-center gap-3 sm:gap-5 glass-panel px-4 py-2.5 rounded-2xl shadow-2xl">
                <!-- Score Indicator -->
                <div class="flex items-center gap-2.5 border-r border-slate-700/80 pr-3 sm:pr-4">
                    <div class="w-8 h-8 rounded-lg bg-amber-500/20 text-amber-400 flex items-center justify-center text-sm">
                        <i class="fa-solid fa-triangle-exclamation"></i>
                    </div>
                    <div>
                        <span class="text-[10px] uppercase font-bold text-slate-400 block leading-none">Risques</span>
                        <span id="score-text" class="text-base sm:text-lg font-black text-white">0 / 5</span>
                    </div>
                </div>

                <!-- Timer Indicator -->
                <div class="flex items-center gap-2.5">
                    <div class="w-8 h-8 rounded-lg bg-restev-500/20 text-restev-400 flex items-center justify-center text-sm">
                        <i class="fa-regular fa-clock"></i>
                    </div>
                    <div>
                        <span class="text-[10px] uppercase font-bold text-slate-400 block leading-none">Temps</span>
                        <span id="timer-text" class="text-base sm:text-lg font-black font-mono text-restev-400">00:00</span>
                    </div>
                </div>
            </div>

            <!-- Action Controls -->
            <div class="pointer-events-auto flex items-center gap-2">
                <button onclick="toggleHistoryDrawer()" class="glass-panel hover:bg-slate-800 text-slate-200 px-3 py-2.5 rounded-2xl flex items-center gap-2 transition active:scale-95 text-xs font-bold shadow-lg" title="Liste des risques">
                    <i class="fa-solid fa-list-check text-restev-500 text-base"></i>
                    <span class="hidden md:inline">Bilan</span>
                </button>
                <button id="btn-sound" onclick="toggleAudio()" class="glass-panel hover:bg-slate-800 text-slate-200 w-10 h-10 rounded-2xl flex items-center justify-center transition active:scale-95 shadow-lg">
                    <i id="sound-icon" class="fa-solid fa-volume-high text-restev-500"></i>
                </button>
                <button onclick="showHelpModal()" class="glass-panel hover:bg-slate-800 text-slate-200 w-10 h-10 rounded-2xl flex items-center justify-center transition active:scale-95 shadow-lg">
                    <i class="fa-solid fa-circle-question text-restev-500"></i>
                </button>
                <button onclick="resetCameraView()" class="glass-panel hover:bg-slate-800 text-slate-200 w-10 h-10 rounded-2xl flex items-center justify-center transition active:scale-95 shadow-lg" title="Recentrer la caméra">
                    <i class="fa-solid fa-camera-rotate text-slate-300"></i>
                </button>
            </div>

        </div>
    </header>

    <!-- WELCOME / START MODAL -->
    <div id="modal-welcome" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-950/85 backdrop-blur-md">
        <div class="glass-panel max-w-2xl w-full p-6 sm:p-8 rounded-3xl shadow-2xl border border-slate-700/60 relative overflow-hidden">
            <div class="absolute -top-16 -right-16 w-48 h-48 bg-restev-500/10 rounded-full blur-3xl pointer-events-none"></div>

            <div class="flex items-center gap-3.5 mb-5">
                <div class="w-12 h-12 rounded-2xl bg-gradient-to-tr from-restev-600 to-emerald-400 text-slate-950 flex items-center justify-center text-2xl font-black shadow-lg">
                    <i class="fa-solid fa-vr-cardboard"></i>
                </div>
                <div>
                    <span class="text-xs font-bold uppercase tracking-widest text-restev-400">Programme de Prévention Adhérents RESTEV</span>
                    <h2 class="text-2xl sm:text-3xl font-black text-white">Chasse aux Risques en Atelier 3D</h2>
                </div>
            </div>

            <p class="text-slate-300 text-sm sm:text-base leading-relaxed mb-6">
                Bienvenue dans le simulateur immersif de santé au travail. Explorez cet atelier industriel en 3D et identifiez <strong class="text-restev-400 font-bold">5 situations à risques majeurs</strong> disséminées dans l'environnement.
            </p>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mb-6">
                <div class="glass-card p-4 rounded-2xl flex items-start gap-3">
                    <i class="fa-solid fa-computer-mouse text-restev-400 text-lg mt-0.5"></i>
                    <div class="text-xs text-slate-300">
                        <strong class="text-white block mb-0.5">Commandes 3D :</strong>
                        Maintenez le clic gauche pour faire pivoter la caméra, utilisez la molette pour zoomer et cliquez directement sur les d'anomalies.
                    </div>
                </div>
                <div class="glass-card p-4 rounded-2xl flex items-start gap-3">
                    <i class="fa-solid fa-headset text-restev-400 text-lg mt-0.5"></i>
                    <div class="text-xs text-slate-300">
                        <strong class="text-white block mb-0.5">Compatibilité WebXR / VR :</strong>
                        Connectez un casque (ex: Meta Quest) et cliquez sur le bouton <span class="text-restev-400 font-bold">VR</span> en bas de l'écran pour une immersion complète.
                    </div>
                </div>
            </div>

            <button onclick="startSimulation()" class="w-full py-4 px-6 rounded-2xl bg-gradient-to-r from-restev-600 via-restev-500 to-emerald-400 hover:from-restev-500 hover:to-emerald-300 text-slate-950 font-black text-base tracking-wide shadow-xl shadow-restev-600/30 transition-all transform active:scale-98 flex items-center justify-center gap-2">
                <i class="fa-solid fa-play"></i> Démarrer la Sensibilisation
            </button>
        </div>
    </div>

    <!-- PEDAGOGICAL HAZARD MODAL -->
    <div id="modal-hazard" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-950/80 backdrop-blur-md hidden">
        <div class="glass-panel max-w-2xl w-full p-6 sm:p-8 rounded-3xl shadow-2xl border border-slate-700/80 relative max-h-[90vh] flex flex-col justify-between">
            
            <div class="overflow-y-auto pr-2 space-y-4">
                <!-- Header badge -->
                <div class="flex items-center justify-between">
                    <span id="hazard-category-badge" class="px-3.5 py-1 rounded-full text-xs font-extrabold uppercase tracking-wider bg-amber-500/20 text-amber-300 border border-amber-500/30">
                        Risque Décelé
                    </span>
                    <span id="hazard-step-text" class="text-xs font-bold text-slate-400">1 / 5 Découvert</span>
                </div>

                <h3 id="hazard-title" class="text-xl sm:text-2xl font-black text-white">Titre du Risque</h3>
                
                <!-- Danger Description -->
                <div class="p-4 bg-slate-900/90 rounded-2xl border border-slate-800">
                    <h4 class="text-xs uppercase font-extrabold text-amber-400 tracking-wider mb-1 flex items-center gap-2">
                        <i class="fa-solid fa-eye"></i> Constat sur le terrain
                    </h4>
                    <p id="hazard-description" class="text-slate-200 text-sm leading-relaxed">Description détaillée du problème constaté...</p>
                </div>

                <!-- Health & Safety Impact -->
                <div class="p-4 bg-slate-900/90 rounded-2xl border border-slate-800">
                    <h4 class="text-xs uppercase font-extrabold text-rose-400 tracking-wider mb-1 flex items-center gap-2">
                        <i class="fa-solid fa-heart-pulse"></i> Impact Santé & Sécurité
                    </h4>
                    <p id="hazard-impact" class="text-slate-200 text-sm leading-relaxed">Conséquences potentielles pour l'opérateur...</p>
                </div>

                <!-- Prevention Principles & Regulations -->
                <div class="space-y-3 pt-2">
                    <div class="border-l-4 border-restev-500 pl-4 py-1">
                        <h4 class="text-xs font-bold uppercase tracking-wider text-restev-400">Réglementation & Principes Généraux de Prévention</h4>
                        <p id="hazard-regulation" class="text-xs sm:text-sm text-slate-300 mt-1">Code du Travail / Référentiel INRS...</p>
                    </div>

                    <div class="border-l-4 border-emerald-400 pl-4 py-1">
                        <h4 class="text-xs font-bold uppercase tracking-wider text-emerald-400">Recommandation du Service RESTEV</h4>
                        <p id="hazard-prevention" class="text-xs sm:text-sm text-slate-300 mt-1">Actions prioritaires à planifier pour le chef d'entreprise.</p>
                    </div>
                </div>
            </div>

            <!-- Modal Action Footer -->
            <div class="pt-5 mt-4 border-t border-slate-800/80 flex items-center justify-end">
                <button onclick="closeHazardModal()" class="w-full sm:w-auto py-3.5 px-6 rounded-xl bg-gradient-to-r from-restev-600 to-emerald-400 hover:from-restev-500 hover:to-emerald-300 text-slate-950 font-extrabold text-sm tracking-wide shadow-lg transition-all active:scale-95 flex items-center justify-center gap-2">
                    Compris & Validé <i class="fa-solid fa-check"></i>
                </button>
            </div>
        </div>
    </div>

    <!-- LATERAL DRAWER (SUMMARY OF RISKS) -->
    <div id="drawer-history" class="fixed top-0 right-0 bottom-0 w-full sm:w-96 z-40 glass-panel border-l border-slate-700/80 transform translate-x-full transition-transform duration-300 p-6 flex flex-col justify-between">
        <div>
            <div class="flex items-center justify-between pb-4 border-b border-slate-800 mb-4">
                <h3 class="text-lg font-black text-white flex items-center gap-2">
                    <i class="fa-solid fa-clipboard-list text-restev-500"></i> Bilan d'Inspection
                </h3>
                <button onclick="toggleHistoryDrawer()" class="text-slate-400 hover:text-white p-2">
                    <i class="fa-solid fa-xmark text-lg"></i>
                </button>
            </div>

            <p class="text-xs text-slate-400 mb-4">Suivi des 5 d'anomalies de sécurité répertoriées dans l'atelier :</p>

            <div id="history-list" class="space-y-3 max-h-[calc(100vh-220px)] overflow-y-auto pr-1">
                <!-- Dynamic Item List generated via JS -->
            </div>
        </div>

        <button onclick="toggleHistoryDrawer()" class="w-full py-3 rounded-xl bg-slate-800 hover:bg-slate-700 text-white font-bold text-xs uppercase tracking-wider transition">
            Retour au Simulateur
        </button>
    </div>

    <!-- FINAL EVALUATION & CERTIFICATE MODAL -->
    <div id="modal-victory" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-950/90 backdrop-blur-lg hidden">
        <div class="glass-panel max-w-2xl w-full p-6 sm:p-8 rounded-3xl shadow-2xl border border-emerald-500/40 text-center relative max-h-[95vh] overflow-y-auto">
            
            <div class="w-16 h-16 rounded-2xl bg-emerald-500/20 text-emerald-400 flex items-center justify-center text-3xl mx-auto mb-3 border border-emerald-500/40">
                <i class="fa-solid fa-award"></i>
            </div>

            <span class="text-xs font-black uppercase tracking-widest text-emerald-400">Sensibilisation Réussie</span>
            <h2 class="text-2xl sm:text-3xl font-black text-white mt-1 mb-2">Attestation de Parfait Complètement</h2>
            <p class="text-slate-300 text-sm mb-6">Vous avez repéré et traité l'intégralité des risques majeurs de l'atelier RESTEV.</p>

            <div class="grid grid-cols-2 gap-3 mb-6">
                <div class="glass-card p-4 rounded-2xl">
                    <span class="text-xs text-slate-400 font-bold block uppercase">Score Global</span>
                    <span class="text-2xl font-black text-emerald-400">100 % (5/5)</span>
                </div>
                <div class="glass-card p-4 rounded-2xl">
                    <span class="text-xs text-slate-400 font-bold block uppercase">Temps d'Inspection</span>
                    <span id="final-time" class="text-2xl font-black text-restev-400 font-mono">00:00</span>
                </div>
            </div>

            <!-- Participant Name Input for Certificate -->
            <div class="mb-6 text-left glass-card p-4 rounded-2xl">
                <label class="block text-xs font-bold text-slate-300 uppercase tracking-wider mb-2">
                    Nom & Prénom du Participant (pour l'Attestation) :
                </label>
                <input id="participant-name" type="text" placeholder="Ex: Jean Dupont - Technicien / Adhérent" class="w-full px-4 py-2.5 rounded-xl bg-slate-900 border border-slate-700 text-white placeholder-slate-500 focus:outline-none focus:border-restev-500 text-sm">
            </div>

            <div class="flex flex-col sm:flex-row gap-3">
                <button onclick="printCertificate()" class="flex-1 py-3.5 px-4 rounded-xl bg-slate-800 hover:bg-slate-700 text-white font-extrabold text-sm tracking-wide transition flex items-center justify-center gap-2">
                    <i class="fa-solid fa-print"></i> Imprimer l'Attestation
                </button>
                <button onclick="resetSimulation()" class="flex-1 py-3.5 px-4 rounded-xl bg-gradient-to-r from-restev-600 to-emerald-400 hover:from-restev-500 hover:to-emerald-300 text-slate-950 font-extrabold text-sm tracking-wide transition flex items-center justify-center gap-2">
                    <i class="fa-solid fa-rotate-right"></i> Nouvelle Session
                </button>
            </div>
        </div>
    </div>

    <!-- HIDDEN PRINTABLE ATTESTATION TEMPLATE -->
    <div id="certificate-print-area" class="hidden p-8 font-sans max-w-3xl mx-auto border-4 border-teal-800 my-8">
        <div class="text-center border-b-2 border-slate-300 pb-6 mb-6">
            <h1 class="text-3xl font-black text-teal-800 uppercase">RESTEV - Santé au Travail</h1>
            <p class="text-sm text-slate-600">Service de Prévention et de Santé au Travail Adhérents</p>
        </div>
        <div class="text-center my-8">
            <h2 class="text-2xl font-bold uppercase tracking-wider text-slate-800 mb-2">Attestation de Sensibilisation aux Risques</h2>
            <p class="text-slate-600">Délivrée suite à l'évaluation en simulation 3D / WebXR en atelier</p>
        </div>
        <div class="my-8 space-y-4 text-slate-800">
            <p><strong>Participant :</strong> <span id="cert-name-display">__________________________</span></p>
            <p><strong>Module :</strong> Chasse aux Risques Professionnels en Atelier Industriel</p>
            <p><strong>Résultat :</strong> 5 / 5 Risques Décelés avec Succès (Score : 100%)</p>
            <p><strong>Temps de réalisation :</strong> <span id="cert-time-display">00:00</span></p>
            <p class="text-sm text-slate-600 pt-4">Cette sensibilisation valide la compréhension des principes généraux de prévention et de repérage des d'anomalies de sécurité sur le lieu de travail.</p>
        </div>
        <div class="flex justify-between items-end pt-12 mt-12 border-t border-slate-300">
            <div>
                <p class="text-xs text-slate-500">Document généré automatiquement</p>
                <p class="text-xs font-bold text-teal-800">RESTEV Prévention</p>
            </div>
  
