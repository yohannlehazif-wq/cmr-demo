            registerInteractive(h5Group);
        }

        /* Helper to create pulsing ring halo around hazards */
        function createHaloRing() {
            const ringGeo = new THREE.RingGeometry(0.8, 1.0, 24);
            const ringMat = new THREE.MeshBasicMaterial({ color: 0xf59e0b, side: THREE.DoubleSide, transparent: true, opacity: 0.8 });
            const ring = new THREE.Mesh(ringGeo, ringMat);
            ring.rotation.x = -Math.PI / 2;
            ring.position.y = 0.02;
            ring.name = "haloRing";
            return ring;
        }

        /* Register Group Mesh and children for Raycasting */
        function registerInteractive(group) {
            group.traverse(child => {
                if (child.isMesh) {
                    child.userData = group.userData;
                    state.interactiveObjects.push(child);
                }
            });
        }

        function onPointerDown(event) {
            if (!state.started) return;

            state.mouse.x = (event.clientX / window.innerWidth) * 2 - 1;
            state.mouse.y = -(event.clientY / window.innerHeight) * 2 + 1;

            state.raycaster.setFromCamera(state.mouse, state.camera);
            const intersects = state.raycaster.intersectObjects(state.interactiveObjects);

            if (intersects.length > 0) {
                const hitObject = intersects[0].object;
                const hazardId = hitObject.userData.hazardId;
                if (hazardId) {
                    handleHazardFound(hazardId);
                }
            }
        }

        function handleHazardFound(id) {
            const isNew = !state.foundHazards.has(id);
            state.foundHazards.add(id);

            playSound('found');

            // Update 3D Halo color to green
            state.scene.traverse(obj => {
                if (obj.userData && obj.userData.hazardId === id) {
                    obj.traverse(child => {
                        if (child.name === "haloRing") {
                            child.material.color.setHex(0x10b981); // Green solved
                        }
                    });
                }
            });

            // Update Score
            document.getElementById('score-text').innerText = `${state.foundHazards.size} / ${state.totalHazards}`;

            // Show Pedagogical Modal
            const data = hazardsData[id];
            document.getElementById('hazard-category-badge').innerText = data.category;
            document.getElementById('hazard-category-badge').className = `px-3.5 py-1 rounded-full text-xs font-extrabold uppercase tracking-wider border ${data.categoryClass}`;
            document.getElementById('hazard-step-text').innerText = `${state.foundHazards.size} / ${state.totalHazards} Identifié${state.foundHazards.size > 1 ? 's' : ''}`;
            document.getElementById('hazard-title').innerText = data.title;
            document.getElementById('hazard-description').innerText = data.description;
            document.getElementById('hazard-impact').innerText = data.impact;
            document.getElementById('hazard-regulation').innerText = data.regulation;
            document.getElementById('hazard-prevention').innerText = data.prevention;

            document.getElementById('modal-hazard').classList.remove('hidden');

            renderHistoryList();
        }

        function closeHazardModal() {
            playSound('click');
            document.getElementById('modal-hazard').classList.add('hidden');

            if (state.foundHazards.size === state.totalHazards) {
                setTimeout(triggerVictory, 300);
            }
        }

        function triggerVictory() {
            clearInterval(state.timerInterval);
            playSound('victory');
            document.getElementById('modal-victory').classList.remove('hidden');
        }

        function startSimulation() {
            playSound('click');
            document.getElementById('modal-welcome').classList.add('hidden');
            state.started = true;
            state.startTime = Date.now();
            state.timerInterval = setInterval(updateTimer, 1000);
            renderHistoryList();
        }

        function updateTimer() {
            if (!state.startTime) return;
            const elapsed = Math.floor((Date.now() - state.startTime) / 1000);
            const m = Math.floor(elapsed / 60).toString().padStart(2, '0');
            const s = (elapsed % 60).toString().padStart(2, '0');
            const timeStr = `${m}:${s}`;
            document.getElementById('timer-text').innerText = timeStr;
            document.getElementById('final-time').innerText = timeStr;
            document.getElementById('cert-time-display').innerText = timeStr;
        }

        function renderHistoryList() {
            const container = document.getElementById('history-list');
            container.innerHTML = '';

            Object.values(hazardsData).forEach(hazard => {
                const isFound = state.foundHazards.has(hazard.id);
                const item = document.createElement('div');
                item.className = `p-3.5 rounded-2xl border transition ${isFound ? 'bg-slate-900/90 border-emerald-500/40' : 'bg-slate-900/40 border-slate-800 opacity-60'}`;
                item.innerHTML = `
                    <div class="flex items-center justify-between">
                        <span class="text-xs font-bold text-white">${hazard.title}</span>
                        <i class="fa-solid ${isFound ? 'fa-circle-check text-emerald-400' : 'fa-circle-dot text-slate-600'} text-base"></i>
                    </div>
                    <span class="text-[10px] uppercase font-bold text-slate-400 block mt-1">${hazard.category}</span>
                `;
                container.appendChild(item);
            });
        }

        function toggleHistoryDrawer() {
            playSound('click');
            const drawer = document.getElementById('drawer-history');
            drawer.classList.toggle('translate-x-full');
        }

        function printCertificate() {
            playSound('click');
            const nameInput = document.getElementById('participant-name').value.trim();
            document.getElementById('cert-name-display').innerText = nameInput || "Participant Adhérent RESTEV";
            window.print();
        }

        function resetCameraView() {
            playSound('click');
            state.camera.position.set(0, 5, 11);
            state.controls.target.set(0, 1.5, 0);
        }

        function toggleAudio() {
            state.audioEnabled = !state.audioEnabled;
            const icon = document.getElementById('sound-icon');
            icon.className = state.audioEnabled ? 'fa-solid fa-volume-high text-restev-500' : 'fa-solid fa-volume-xmark text-slate-500';
        }

        function showHelpModal() {
            playSound('click');
            document.getElementById('modal-help').classList.remove('hidden');
        }

        function closeHelpModal() {
            playSound('click');
            document.getElementById('modal-help').classList.add('hidden');
        }

        function resetSimulation() {
            playSound('click');
            state.foundHazards.clear();
            clearInterval(state.timerInterval);
            state.startTime = Date.now();
            
            document.getElementById('score-text').innerText = `0 / ${state.totalHazards}`;
            document.getElementById('timer-text').innerText = '00:00';
            
            document.getElementById('modal-victory').classList.add('hidden');
            document.getElementById('modal-hazard').classList.add('hidden');
            document.getElementById('modal-welcome').classList.remove('hidden');

            // Reset halos in scene
            state.scene.traverse(obj => {
                if (obj.name === "haloRing") {
                    obj.material.color.setHex(0xf59e0b);
                }
            });

            resetCameraView();
            renderHistoryList();
        }

        function onWindowResize() {
            state.camera.aspect = window.innerWidth / window.innerHeight;
            state.camera.updateProjectionMatrix();
            state.renderer.setSize(window.innerWidth, window.innerHeight);
        }

        function animate(timestamp) {
            // Pulsate halos
            if (state.scene) {
                state.scene.traverse(obj => {
                    if (obj.name === "haloRing") {
                        const s = 1 + Math.sin(timestamp * 0.005) * 0.15;
                        obj.scale.set(s, s, s);
                    }
                });
            }

            state.controls.update();
            state.renderer.render(state.scene, state.camera);
        }

        // Initialize 3D Application on window load
        window.onload = function() {
            init3DScene();
        };
    </script>
