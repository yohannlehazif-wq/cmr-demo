        /* WEB AUDIO API SOUND SYSTEM */
        const audioCtx = new (window.AudioContext || window.webkitAudioContext)();

        function playSound(type) {
            if (!state.audioEnabled) return;
            if (audioCtx.state === 'suspended') audioCtx.resume();

            const osc = audioCtx.createOscillator();
            const gain = audioCtx.createGain();
            osc.connect(gain);
            gain.connect(audioCtx.destination);
            const now = audioCtx.currentTime;

            if (type === 'found') {
                osc.type = 'sine';
                osc.frequency.setValueAtTime(440, now);
                osc.frequency.exponentialRampToValueAtTime(880, now + 0.2);
                gain.gain.setValueAtTime(0.2, now);
                gain.gain.exponentialRampToValueAtTime(0.01, now + 0.35);
                osc.start(now);
                osc.stop(now + 0.35);
            } else if (type === 'victory') {
                [523.25, 659.25, 783.99, 1046.50].forEach((f, i) => {
                    const subOsc = audioCtx.createOscillator();
                    const subGain = audioCtx.createGain();
                    subOsc.connect(subGain);
                    subGain.connect(audioCtx.destination);
                    subOsc.frequency.setValueAtTime(f, now + i * 0.08);
                    subGain.gain.setValueAtTime(0.15, now + i * 0.08);
                    subGain.gain.exponentialRampToValueAtTime(0.01, now + i * 0.08 + 0.4);
                    subOsc.start(now + i * 0.08);
                    subOsc.stop(now + i * 0.08 + 0.4);
                });
            } else if (type === 'click') {
                osc.type = 'triangle';
                osc.frequency.setValueAtTime(300, now);
                gain.gain.setValueAtTime(0.1, now);
                gain.gain.exponentialRampToValueAtTime(0.01, now + 0.05);
                osc.start(now);
                osc.stop(now + 0.05);
            }
        }

        /* THREE.JS SCENE CREATION & GEOMETRY */
        function init3DScene() {
            const container = document.getElementById('canvas-container');
            
            // Scene
            state.scene = new THREE.Scene();
            state.scene.background = new THREE.Color(0x0f172a);
            state.scene.fog = new THREE.FogExp2(0x0f172a, 0.035);

            // Camera
            state.camera = new THREE.PerspectiveCamera(60, window.innerWidth / window.innerHeight, 0.1, 100);
            state.camera.position.set(0, 5, 11);

            // Renderer with WebXR support
            state.renderer = new THREE.WebGLRenderer({ antialias: true, powerPreference: "highPerformance" });
            state.renderer.setSize(window.innerWidth, window.innerHeight);
            state.renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
            state.renderer.shadowMap.enabled = true;
            state.renderer.shadowMap.type = THREE.PCFSoftShadowMap;
            state.renderer.xr.enabled = true;
            container.appendChild(state.renderer.domElement);

            // WebXR VR Button
            document.body.appendChild(THREE.VRButton.createButton(state.renderer));

            // Controls
            state.controls = new THREE.OrbitControls(state.camera, state.renderer.domElement);
            state.controls.enableDamping = true;
            state.controls.dampingFactor = 0.05;
            state.controls.maxPolarAngle = Math.PI / 2 - 0.05;
            state.controls.minDistance = 2;
            state.controls.maxDistance = 18;
            state.controls.target.set(0, 1.5, 0);

            // Lighting
            const ambientLight = new THREE.AmbientLight(0x94a3b8, 0.6);
            state.scene.add(ambientLight);

            const dirLight = new THREE.DirectionalLight(0xffffff, 0.9);
            dirLight.position.set(-6, 12, 6);
            dirLight.castShadow = true;
            dirLight.shadow.mapSize.width = 1024;
            dirLight.shadow.mapSize.height = 1024;
            dirLight.shadow.camera.near = 0.5;
            dirLight.shadow.camera.far = 25;
            state.scene.add(dirLight);

            // Interior SpotLight
            const spotLight = new THREE.SpotLight(0x14b8a6, 1.2);
            spotLight.position.set(0, 8, 0);
            spotLight.angle = Math.PI / 3;
            spotLight.penumbra = 0.8;
            state.scene.add(spotLight);

            // BUILD ENVIRONMENT
            buildWorkshopRoom();
            buildProps();
            buildHazards();

            // Event Listeners
            window.addEventListener('resize', onWindowResize);
            state.renderer.domElement.addEventListener('pointerdown', onPointerDown);

            // Animation Loop
            state.renderer.setAnimationLoop(animate);
        }

        function buildWorkshopRoom() {
            // Floor
            const floorGeo = new THREE.PlaneGeometry(24, 20);
