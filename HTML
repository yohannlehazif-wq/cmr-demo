            const palletMat = new THREE.MeshStandardMaterial({ color: 0x854d0e, roughness: 0.9 });
            const pallet = new THREE.Mesh(new THREE.BoxGeometry(1.4, 0.2, 1.2), palletMat);
            pallet.position.y = 0.1;
            h5Group.add(pallet);

            // Safety Helmet on ground
            const helmet = new THREE.Mesh(
                new THREE.SphereGeometry(0.22, 12, 12, 0, Math.PI * 2, 0, Math.PI / 1.8),
