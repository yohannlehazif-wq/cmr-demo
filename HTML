            drum.rotation.z = Math.PI / 2;
            drum.position.y = 0.45;
            drum.castShadow = true;
            h1Group.add(drum);

            // Spill puddle
            const puddle = new THREE.Mesh(
                new THREE.CircleGeometry(0.9, 16),
