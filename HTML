            // HAZARD 3: Unstable Stepladder
            const h3Group = new THREE.Group();
            h3Group.userData = { hazardId: 3 };

            const ladderMat = new THREE.MeshStandardMaterial({ color: 0x94a3b8, metalness: 0.8 });
            const side1 = new THREE.Mesh(new THREE.BoxGeometry(0.06, 2.4, 0.06), ladderMat);
            side1.position.set(-0.35, 1.2, 0);
            h3Group.add(side1);

            const side2 = new THREE.Mesh(new THREE.BoxGeometry(0.06, 2.4, 0.06), ladderMat);
            side2.position.set(0.35, 1.2, 0);
            h3Group.add(side2);

            // Steps
            for (let y = 0.4; y <= 2.0; y += 0.4) {
                const step = new THREE.Mesh(new THREE.BoxGeometry(0.7, 0.04, 0.06), ladderMat);
                step.position.set(0, y, 0);
                h3Group.add(step);
            }

            // Crooked shim base
            const shim = new THREE.Mesh(
                new THREE.BoxGeometry(0.4, 0.2, 0.4),
                new THREE.MeshStandardMaterial({ color: 0x78350f })
            );
            shim.position.set(-0.35, 0.1, 0);
            shim.rotation.z = 0.2;
            h3Group.add(shim);

            h3Group.rotation.z = -0.18; // Tilted angle
            const halo3 = createHaloRing();
            h3Group.add(halo3);

            h3Group.position.set(-10, 0, 1.5);
            state.scene.add(h3Group);
            registerInteractive(h3Group);


            // HAZARD 4: Collapsing Cardboard Stack
            const h4Group = new THREE.Group();
            h4Group.userData = { hazardId: 4 };

            const boxMat = new THREE.MeshStandardMaterial({ color: 0xb45309, roughness: 0.8 });
            
            const b1 = new THREE.Mesh(new THREE.BoxGeometry(0.9, 0.7, 0.8), boxMat);
            b1.position.set(0, 0.35, 0);
            h4Group.add(b1);

            const b2 = new THREE.Mesh(new THREE.BoxGeometry(0.85, 0.65, 0.75), boxMat);
            b2.position.set(0.1, 1.0, 0.05);
            b2.rotation.y = 0.2;
            h4Group.add(b2);

            const b3 = new THREE.Mesh(new THREE.BoxGeometry(0.8, 0.6, 0.7), boxMat);
            b3.position.set(0.3, 1.6, 0.1);
            b3.rotation.z = 0.25; // Leaning dangerously
            h4Group.add(b3);

            const halo4 = createHaloRing();
            h4Group.add(halo4);

            h4Group.position.set(4, 0, -6);
            state.scene.add(h4Group);
